@model TSD2491Gruppe25.Web.ViewModels.BrregImportViewModel

@{
    ViewData["Title"] = "Importer fra Brreg";
}

<h1 class="text-3xl font-bold mb-6">Importer bedrifter fra Brreg</h1>

<hr class="mb-6" />

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="mb-4 rounded bg-green-100 border border-green-300 text-green-800 px-4 py-3">
        @successMessage
    </div>
}

@if (TempData["InfoMessage"] is string infoMessage)
{
    <div class="mb-4 rounded bg-yellow-100 border border-yellow-300 text-yellow-800 px-4 py-3">
        @infoMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="mb-4 rounded bg-red-100 border border-red-300 text-red-800 px-4 py-3">
        @errorMessage
    </div>
}

<div class="max-w-xl">
    <form asp-action="Index" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

        <div>
            <label asp-for="Soketekst" class="block font-medium mb-1"></label>
            <input asp-for="Soketekst"
                   class="w-full border border-gray-300 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="Soketekst" class="text-red-600 text-sm"></span>
        </div>

        <div>
            <label asp-for="KategoriId" class="block font-medium mb-1"></label>
            <select asp-for="KategoriId" asp-items="Model.Kategorier"
                    class="w-full border border-gray-300 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="">-- Velg kategori --</option>
            </select>
            <span asp-validation-for="KategoriId" class="text-red-600 text-sm"></span>
        </div>

        <div class="flex items-center gap-3 pt-3">
            <button type="submit"
                    class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 font-medium cursor-pointer">
                Importer
            </button>

            <a asp-controller="Bedrifter" asp-action="Index"
               class="inline-block px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 font-medium">
                Tilbake
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
