@model TSD2491Gruppe25.Web.Models.Bedrift

@{
    ViewData["Title"] = "Details";
}

<h1 class="text-3xl font-bold mb-6">Detaljer</h1>

<div class="max-w-3xl bg-white shadow-sm rounded p-6">
    <h4 class="text-xl font-semibold mb-4">Bedrift</h4>
    <hr class="mb-6" />

    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-4 text-sm">
        <dt class="font-semibold">
            @Html.DisplayNameFor(model => model.Organisasjonsnummer)
        </dt>
        <dd class="sm:col-span-2">
            @Html.DisplayFor(model => model.Organisasjonsnummer)
        </dd>

        <dt class="font-semibold">
            @Html.DisplayNameFor(model => model.Navn)
        </dt>
        <dd class="sm:col-span-2">
            @Html.DisplayFor(model => model.Navn)
        </dd>

        <dt class="font-semibold">
            @Html.DisplayNameFor(model => model.Organisasjonsform)
        </dt>
        <dd class="sm:col-span-2">
            @Html.DisplayFor(model => model.Organisasjonsform)
        </dd>

        <dt class="font-semibold">
            Status
        </dt>

        <dd class="sm:col-span-2">
            @if (Model.ErAktiv)
            {
                <span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-green-600 text-white">
                    Aktiv
                </span>
            }
            else
            {
                <span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-gray-500 text-white">
                    Inaktiv
                </span>
            }
        </dd>


        <dt class="font-semibold">
            @Html.DisplayNameFor(model => model.Registreringsdato)
        </dt>
        <dd class="sm:col-span-2">
            @(Model.Registreringsdato?.ToString("dd/MM/yyyy") ?? "-")
        </dd>

        <dt class="font-semibold">
            @Html.DisplayNameFor(model => model.Notat)
        </dt>
        <dd class="sm:col-span-2">
            @Html.DisplayFor(model => model.Notat)
        </dd>

        <dt class="font-semibold">
            @Html.DisplayNameFor(model => model.Kategori)
        </dt>
        <dd class="sm:col-span-2">
            @(Model.Kategori?.KategoriNavn ?? "-")
        </dd>
    </dl>
</div>

<div class="mt-6 flex items-center gap-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id"
           class="inline-block px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 font-medium">
        Endre
    </a>

    <a asp-action="Index" class="inline-block px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 font-medium">
        Tilbake til listen
    </a>
</div>
