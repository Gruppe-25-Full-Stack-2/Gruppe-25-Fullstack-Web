@model TSD2491Gruppe25.Web.Models.Bedrift

@{
    ViewData["Title"] = "Create";
}

<h1 class="text-3xl font-bold mb-6">Legg til Bedrifter</h1>

<hr class="mb-6" />

<div class="max-w-xl">
    <form asp-action="Create" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

        <div>
            <label asp-for="Organisasjonsnummer" class="block font-medium mb-1"></label>
            <input asp-for="Organisasjonsnummer"
                   class="w-full border border-gray-300 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="Organisasjonsnummer" class="text-red-600 text-sm"></span>
        </div>

        <div>
            <label asp-for="Navn" class="block font-medium mb-1"></label>
            <input asp-for="Navn"
                   class="w-full border border-gray-300 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="Navn" class="text-red-600 text-sm"></span>
        </div>

        <div>
            <label asp-for="Organisasjonsform" class="block font-medium mb-1"></label>
            <input asp-for="Organisasjonsform"
                   class="w-full border border-gray-300 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="Organisasjonsform" class="text-red-600 text-sm"></span>
        </div>

        <div class="flex items-center gap-2">
            <input asp-for="ErAktiv"
                   class="h-4 w-4 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500" />
            <label asp-for="ErAktiv" class="font-medium">Aktiv</label>
        </div>

        <div>
            <label asp-for="Registreringsdato" class="block font-medium mb-1"></label>
            <input asp-for="Registreringsdato"
                   class="w-full border border-gray-300 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="Registreringsdato" class="text-red-600 text-sm"></span>
        </div>

        <div>
            <label asp-for="Notat" class="block font-medium mb-1"></label>
            <input asp-for="Notat"
                   class="w-full border border-gray-300 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <span asp-validation-for="Notat" class="text-red-600 text-sm"></span>
        </div>

        <div>
            <label asp-for="KategoriId" class="block font-medium mb-1">Kategori</label>
            <select asp-for="KategoriId"
                    asp-items="ViewBag.KategoriId"
                    class="w-full border border-gray-300 rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
            </select>
            <span asp-validation-for="KategoriId" class="text-red-600 text-sm"></span>
        </div>

        <div class="flex items-center gap-3 pt-3">
            <input type="submit"
                   value="Opprett"
                   class="inline-block px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 font-medium cursor-pointer" />

            <a asp-action="Index"
               class="inline-block px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 font-medium">
                Tilbake
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
