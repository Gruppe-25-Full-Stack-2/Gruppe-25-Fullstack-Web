@model TSD2491Gruppe25.Web.Models.Bedrift

@{
    ViewData["Title"] = "Delete";
}

<div class="max-w-3xl bg-white shadow-sm rounded p-6">
    <p class="text-red-700 font-semibold mb-4">
        Er du sikker på at du ønsker å slette denne bedriften?
    </p>

    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-4 text-sm mb-6">
        <dt class="font-semibold">Organisasjonsnummer</dt>
        <dd class="sm:col-span-2">@Model.Organisasjonsnummer</dd>

        <dt class="font-semibold">Navn</dt>
        <dd class="sm:col-span-2">@Model.Navn</dd>

        <dt class="font-semibold">Organisasjonsform</dt>
        <dd class="sm:col-span-2">@Model.Organisasjonsform</dd>

        <dt class="font-semibold">Status</dt>
        <dd class="sm:col-span-2">
            @if (Model.ErAktiv)
            {
                <span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-green-600 text-white">
                    Aktiv
                </span>
            }
            else
            {
                <span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-gray-500 text-white">
                    Inaktiv
                </span>
            }
        </dd>

        <dt class="font-semibold">Registreringsdato</dt>
        <dd class="sm:col-span-2">
            @(Model.Registreringsdato?.ToString("dd/MM/yyyy") ?? "-")
        </dd>


        <dt class="font-semibold">Notat</dt>
        <dd class="sm:col-span-2">@Model.Notat</dd>

        <dt class="font-semibold">Kategori</dt>
        <dd class="sm:col-span-2">
            @(Model.Kategori?.KategoriNavn ?? "-")
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="flex items-center gap-3">
            <input type="submit" value="Slett"
                   class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 font-medium cursor-pointer" />

            <a asp-action="Index" class="px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600 font-medium">
                Avbryt
            </a>
        </div>
    </form>
</div>
