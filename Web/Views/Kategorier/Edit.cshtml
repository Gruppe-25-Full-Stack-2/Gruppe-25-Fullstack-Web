@model TSD2491Gruppe25.Web.Models.Kategori

@{
    ViewData["Title"] = "Edit";
}

<h1 class="text-2xl font-bold mb-4">Rediger</h1>

<hr class="mb-6"/>

<div class="max-w-md mx-auto">
    <form asp-action="Edit" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-600"></div>
        <input type="hidden" asp-for="Id" />
        <div>
            <label asp-for="KategoriNavn" class="block font-medium mb-1">Kategori</label>
            <input asp-for="KategoriNavn" class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring focus:ring-blue-300" />
            <span asp-validation-for="KategoriNavn" class="text-red-600 text-sm"></span>
        </div>

        <div class="flex gap-3 pt-2">
            <input type="submit" value="Lagre" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded cursor-pointer" />
            <a asp-action="Index" class="bg-gray-600 hover:bg-gray-700 text-white font-medium px-4 py-2 rounded">Tilbake til listen</a>
        </div>
    </form>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
