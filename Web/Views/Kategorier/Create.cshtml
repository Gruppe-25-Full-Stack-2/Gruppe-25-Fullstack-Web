@model TSD2491Gruppe25.Web.Models.Kategori

@{
    ViewData["Title"] = "Create";
}

<h1 class="text-2xl font-bold mb-4"> Legg til kategori</h1>

<hr class="mb-6" />
<div class="max-w-md mx-auto">   
    <form asp-action="Create" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div>
                <label asp-for="KategoriNavn" class="block font-medium mb-1"></label>
                <input asp-for="KategoriNavn" class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring focus:ring-blue-300" />
                <span asp-validation-for="KategoriNavn" class="text-red-600 text-sm"></span>
            </div>
            <div class="flex gap-3 pt-2">
                <input type="submit" value="Opprett" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded cursor-pointer" />
                <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white font-medium px-4 py-2 rounded">Tilbake til listen</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
