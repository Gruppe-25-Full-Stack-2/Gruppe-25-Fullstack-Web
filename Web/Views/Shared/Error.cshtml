@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="max-w-3xl mx-auto mt-12 bg-white shadow-sm rounded p-6">
    <h1 class="text-3xl font-bold text-red-600 mb-4">Error</h1>
    <h2 class="text-lg text-red-500 mb-6">
        Det oppstod en feil under behandling av forespørselen din.
    </h2>

    @if (Model.ShowRequestId)
    {
        <p class="mb-4 text-sm text-gray-700">
            <strong>Request ID:</strong>
            <code class="bg-gray-100 px-2 py-1 rounded">@Model.RequestId</code>
        </p>
    }

    <h3 class="text-xl font-semibold mt-6 mb-2">Development Mode</h3>
    <p class="text-gray-700 mb-3">
        Hvis du bytter til <strong>utviklingsmiljø</strong> vil du få mer detaljert informasjon om feilen som oppstod.
    </p>

    <p class="text-gray-700">
        <strong>Utviklingsmiljøet bør ikke være aktivert i applikasjoner som er satt i produksjon.</strong>
        Det kan medføre feilaktig visning av sensitiv informasjon til brukerene.
        For lokal feilsøking kan du aktiviere <strong>utviklingsmiljøet</strong> ved å sette 
        miljøvariabelen <strong>ASPNETCORE_ENVIRONMENT</strong> til
        <strong>Development</strong> og restarte applikasjonen.
    </p>
</div>
