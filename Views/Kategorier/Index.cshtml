@model IEnumerable<TSD2491Gruppe25.Web.Models.Kategori>

@{
    ViewData["Title"] = "Index";
}

<h1>Kategorier</h1>

<p>
    <a asp-action="Create">Lag ny kategori</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.KategoriNavn)
            </th>
            <th>Antall bedrifter</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td> @item.KategoriNavn</td>
                <td>@item.Bedrifter.Count</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Rediger</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Detaljer</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Slett</a>
                </td>
            </tr>
        }
    </tbody>
</table>
