@using Microsoft.CodeAnalysis.CSharp.Syntax
@model TSD2491Gruppe25.Web.Models.Kategori

@{
    ViewData["Title"] = "Delete";
}

<h1>Slett</h1>

@{
    var antall = Model.Bedrifter?.Count() ?? 0;
}

@if(antall == 0)
{
    <h3>Er du sikker på at du vil slette denne kategorien?</h3>
}
else if(antall > 10) 
{
    <h3 class="text-red-600 font-bold">
        Er du sikker på at du vil slette kategorien 
        <span class="underline">@Model.KategoriNavn</span>?
    </h3>
    <p class="mt-2 text-red-500 font-semibold">
        Denne kategorien inneholde @antall bedrifter.
    </p>
}
else 
{
    <h3 class="text-red-600 font-bold">
    Er du sikker på at du vil slette kategorien 
    <span class="underline">@Model.KategoriNavn</span>
    med tilhørende bedrifter?
    </h3>
    <p class="mt-2">Denne kategorien inneholder følgende bedrifter:</p>
    <ul class="list-disc ml-6">
        @foreach (var b in Model.Bedrifter)
        {
            <li>@b.Navn</li>
        }
    </ul>
}


<div class="mt-4">
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Kategori</dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.KategoriNavn)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Slett" class="btn btn-danger me-2" /> 
        <a asp-action="Index" class="btn btn-secondary">Tilbake til listen</a>
    </form>
</div>
