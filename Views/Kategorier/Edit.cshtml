@model TSD2491Gruppe25.Web.Models.Kategori

@{
    ViewData["Title"] = "Edit";
}

<h1>Rediger</h1>

<h4>Kategori</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="KategoriNavn" class="control-label"></label>
                <input asp-for="KategoriNavn" class="form-control" />
                <span asp-validation-for="KategoriNavn" class="text-danger"></span>
            </div>
            <div class="form-group mt-1">
                <input type="submit" value="Lagre" class="btn btn-primary me-2" />
                <a asp-action="Index" class="btn btn-secondary">Tilbake til listen</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
