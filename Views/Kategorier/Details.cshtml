@model TSD2491Gruppe25.Web.Models.Kategori

@{
    ViewData["Title"] = "Details";
}

<h1 class="text-2xl font-bold mb-4">Detaljer</h1>

<div class="mb-6">
    <hr class="mb-4" />

    <dl class="grid grid-cols-2 gap-4">
        <dt class="font-semibold">Kategori</dt>
        <dd>@Html.DisplayFor(model => model.KategoriNavn)</dd>
    </dl>
</div>

<div class="mt-6">
    <p class="font-semibold text-lg mb-2">Bedrifter i denne kategorien</p>

    @if (Model.Bedrifter != null && Model.Bedrifter.Any())
    {
        <ul class="list-disc ml-6 space-y-1">
            @foreach (var bedrift in Model.Bedrifter)
            {
                <li>@bedrift.Navn</li>
            }
        </ul>
    }
    else
    {
        <p class="text-gray-600">Ingen bedrifter registrert i denne kategorien.</p>
    }
</div>

<div class="mt-6 flex gap-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="bg-yellow-500 hover:bg-yellow-600 text-white font-medium px-4 py-2 rounded">Rediger</a>
    <a asp-action="Index" class="bg-gray-600 hover:bg-gray-700 text-white font-medium px-4 py-2 rounded">Tilbake til liste</a>
</div>
