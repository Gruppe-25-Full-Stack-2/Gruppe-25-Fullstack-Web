@model TSD2491Gruppe25.Web.Models.Kategori

@{
    ViewData["Title"] = "Details";
}

<h1>Detaljer</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Kategori</dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.KategoriNavn)
        </dd>
    </dl>
</div>

<div class="mt-3">
    <p class="fw-bold mt-3">Bedrifter i denne kategorien</p>

    @if (Model.Bedrifter != null && Model.Bedrifter.Any())
    {
        <ul>
            @foreach (var bedrift in Model.Bedrifter)
            {
                <li>@bedrift.Navn</li>
            }
        </ul>
    }
    else
    {
        <p>Ingen bedrifter registrert i denne kategorien.</p>
    }
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning me-2">Rediger</a>
    <a asp-action="Index" class="btn btn-secondary">Tilbake til liste</a>
</div>
