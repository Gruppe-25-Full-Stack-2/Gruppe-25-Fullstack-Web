@model IEnumerable<TSD2491Gruppe25.Web.Models.Bedrift>

@{
    ViewData["Title"] = "Bedrifter";
}

<h1 class="text-3xl font-bold mb-6">Bedrifter</h1>

<div class="flex items-center mb-4">
    <a asp-action="Create" class="inline-block px-4 py-2 bg-green-600 text-white rounded
    hover:bg-green-700 font-medium">Ny bedrift</a>

    <form asp-action="Index" method="get" class="flex items-center ml-auto">
        <label for="kategoriId" class="mr-2">Filtrer på kategori:</label>
        <select name="kategoriId" id="kategoriId" class="border border-gray-300 rounded px-3 py-2 bg-white focus:outline-none
            focus:ring-2 focus:ring-blue-500" asp-items="ViewBag.KategoriFilter" onchange="this.form.submit()">
            <option value="">Alle</option>
        </select>
    </form>
</div>

<table class="w-full border-collapse bg-white shadow-sm rounded overflow-hidden">
    <thead class="bg-gray-100 text-left text-sm font-semibold text-gray-700">
        <tr>
            <th class="px-4 py-2">@Html.DisplayNameFor(model => model.Organisasjonsnummer)</th>
            <th class="px-4 py-2">@Html.DisplayNameFor(model => model.Navn)</th>
            <th class="px-4 py-2">@Html.DisplayNameFor(model => model.Organisasjonsform)</th>
            <th class="px-4 py-2">Status</th>
            <th class="px-4 py-2">@Html.DisplayNameFor(model => model.Registreringsdato)</th>
            <th class="px-4 py-2">@Html.DisplayNameFor(model => model.Notat)</th>
            <th class="px-4 py-2">Kategori</th>
            <th class="px-4 py-2"></th>
        </tr>
    </thead>
    <tbody class="text-sm">
        @foreach (var item in Model)
        {
            <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-2">@Html.DisplayFor(modelItem => item.Organisasjonsnummer)</td>
                <td class="px-4 py-2">@Html.DisplayFor(modelItem => item.Navn)</td>
                <td class="px-4 py-2">@Html.DisplayFor(modelItem => item.Organisasjonsform)</td>
                <td class="px-4 py-2">
                    @if (item.ErAktiv)
                    {
                        <span class="inline-block px-2 py-1 text-xs font-semibold rounded
                        bg-green-600 text-white">Aktiv</span>
                    }
                    else
                    {
                        <span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-gray-500
                        text-white">Inaktiv</span>
                    }
                </td>
                <td class="px-4 py-2">@Html.DisplayFor(modelItem => item.Registreringsdato)</td>
                <td class="px-4 py-2">@Html.DisplayFor(modelItem => item.Notat)</td>
                <td class="px-4 py-2">@item.Kategori?.KategoriNavn</td>

                <td class="px-4 py-2 flex gap-2">
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded text-sm">Rediger</a>
                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm">Detaljer</a>
                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm">Slett</a>
                </td>
            </tr>
        }
    </tbody>
</table>
