@model TSD2491Gruppe25.Web.Models.Bedrift

@{
    ViewData["Title"] = "Delete";
}


<h1>Er du sikker på at du ønsker å slette bedriften?</h1>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Organisasjonsnummer)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Organisasjonsnummer)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Navn)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Navn)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Organisasjonsform)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Organisasjonsform)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ErAktiv)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ErAktiv)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Registreringsdato)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Registreringsdato)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Notat)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Notat)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Kategori)
        </dt>
        <dd class="col-sm-10">
            @(Model.Kategori?.KategoriNavn)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="mt-3">
            <input type="submit" value="Slett" class="btn btn-danger me-2" />
            <a asp-action="Index" class="btn btn-secondary">Tilbake til listen</a>
        </div>
    </form>
</div>
