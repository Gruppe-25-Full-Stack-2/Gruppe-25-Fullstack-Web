@model TSD2491Gruppe25.Web.Models.Bedrift

@{
    ViewData["Title"] = "Edit";
}

<h1>Rediger</h1>

<h4>Bedrift</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Organisasjonsnummer" class="control-label"></label>
                <input asp-for="Organisasjonsnummer" class="form-control" />
                <span asp-validation-for="Organisasjonsnummer" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Navn" class="control-label"></label>
                <input asp-for="Navn" class="form-control" />
                <span asp-validation-for="Navn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Organisasjonsform" class="control-label"></label>
                <input asp-for="Organisasjonsform" class="form-control" />
                <span asp-validation-for="Organisasjonsform" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="ErAktiv" /> Aktiv
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Registreringsdato" class="control-label"></label>
                <input asp-for="Registreringsdato" class="form-control" />
                <span asp-validation-for="Registreringsdato" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Notat" class="control-label"></label>
                <input asp-for="Notat" class="form-control" />
                <span asp-validation-for="Notat" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="KategoriId" class="control-label"></label>
                <select asp-for="KategoriId" class="form-control" asp-items="ViewBag.KategoriId"></select>
                <span asp-validation-for="KategoriId" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Lagre" class="btn btn-primary me-2" />
                <a asp-action="Index" class="btn btn-secondary">Tilbake til listen</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
