 {
    "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
    "metadata": [
      {
        "src": [
          {
            "src": "../Web",
            "files": [
              "**/*.csproj"
            ]
          }
        ],
        "dest": "api"
      }
    ],
    "build": {
      "content": [
        {
          "files": [
            "**/*.{md,yml}"
          ],
          "exclude": [
            "_site/**"
          ]
        }
      ],
      "resource": [
        {
          "files": [
            "images/**"
          ]
        }
      ],
      "output": "_site",
      "template": [
        "default",
        "modern"
      ],
      "globalMetadata": {
        "_appName": "TSD2491 Gruppe 25",
        "_appTitle": "TSD2491 Gruppe 25 — Dokumentasjon",
        "_enableSearch": true,
        "pdf": true
      }
    }
  }
